{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schema/student.schema.json",
  "title": "Student",
  "description": "One row of the students table (CST463 Laravel Lab, Activity 6)",
  "type": "object",
  "properties": {
    "id":         { "type": "integer", "minimum": 1, "description": "Auto-increment primary key" },
    "roll_no":    { "type": "string", "minLength": 1, "maxLength": 20, "description": "Unique roll number, e.g. CS23-01 or 31" },
    "name":       { "type": "string", "minLength": 1, "maxLength": 100 },
    "email":      { "type": "string", "format": "email" },
    "department": { "type": "string", "default": "CSE" },
    "semester":   { "type": "integer", "minimum": 1, "maximum": 8, "default": 7 },
    "cgpa":       { "type": ["string", "number", "null"], "pattern": "^\\d{1,2}(\\.\\d{1,2})?$", "minimum": 0, "maximum": 10, "description": "Decimal(4,2); Laravel serialises decimals as strings, e.g. \"8.72\"" },
    "created_at": { "type": ["string", "null"], "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "required": ["id", "roll_no", "name", "email", "department", "semester"],
  "additionalProperties": false
}
